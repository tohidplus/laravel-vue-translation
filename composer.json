{
    "name": "tohidplus/laravel-vue-translation",
    "description": "Use your Laravel translation files in Vue.js and any other JavaScript application",
    "keywords": [
        "laravel",
        "vue",
        "vuejs",
        "vite",
        "translation",
        "localization",
        "i18n"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/tohidplus/laravel-vue-translation",
    "authors": [
        {
            "name": "Tohid",
            "email": "tohid.dadashnejad@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/tohidplus/laravel-vue-translation/issues",
        "source": "https://github.com/tohidplus/laravel-vue-translation"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5.3|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Tohidplus\\Translation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tohidplus\\Translation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tohidplus\\Translation\\TranslationServiceProvider"
            ],
            "aliases": {
                "VueTranslation": "Tohidplus\\Translation\\Facades\\VueTranslation"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
